{
  "name": "constants",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/constants/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/constants",
        "main": "libs/constants/src/index.ts",
        "tsConfig": "libs/constants/tsconfig.lib.json",
        "assets": ["libs/constants/*.md"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun test --parallel --no-env-file --pass-with-no-tests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.spec.json --noEmit"
      }
    }
  }
}
