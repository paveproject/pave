# Bearer secret CD sends when it reports a shipped mobile version (see
# pave's .github/workflows/mobile-router.yml and
# apps/api/src/app/internal/version_policy) - generate your own
# (openssl rand -hex 32), not tied to any external provider.
API_INTERNAL_VERSION_POLICY_SECRET=

# APP STORE CONNECT
# Confirms a new iOS version is actually live on the App Store (see
# apps/api/src/libs/app_store_connect.rs and
# apps/api/src/app/webhooks/app_store_connect). All optional - the
# feature just stays a no-op until these are set.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=
APP_STORE_CONNECT_APP_ID=
APP_STORE_CONNECT_WEBHOOK_SECRET=

# GEOIP
# Resolves the approximate city/country a new device registration came
# from (see apps/api/src/libs/geoip.rs) - optional, the feature just
# stays a no-op until this is set. Requires a free MaxMind account:
# 1. Sign up at https://www.maxmind.com/en/geolite2/signup
# 2. Generate a license key under Account > Manage License Keys
# 3. Download "GeoLite2 City" (the .mmdb file, not the CSV) from
#    https://www.maxmind.com/en/accounts/current/geoip/downloads
# 4. Point this at the extracted .mmdb file, e.g. ./GeoLite2-City.mmdb
GEOIP_DB_PATH=
