--- a/native/ios/WatermelonDB/JSIInstaller.h
+++ b/native/ios/WatermelonDB/JSIInstaller.h
@@ -2,12 +2,20 @@
 
 #import <React/RCTBridge+Private.h>
 
+// React Native 0.87+ removed RCTCxxBridge entirely (bridgeless-only
+// architecture) - the underlying bridge object still responds to
+// `runtime` at runtime, the header just no longer declares it, so
+// declare it ourselves to keep calling it from Objective-C++.
+@interface RCTBridge (WMJSIRuntime)
+- (void *)runtime;
+@end
+
 #ifdef __cplusplus
 extern "C"
 {
 #endif
 
-void installWatermelonJSI(RCTCxxBridge *bridge);
+void installWatermelonJSI(RCTBridge *bridge);
 void watermelondbProvideSyncJson(int id, NSData *json, NSError **errorPtr);
 
 #ifdef __cplusplus
